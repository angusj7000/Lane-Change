<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#050505">
    <title>{{ shop.name }} — Coming Soon</title>
    <meta name="description" content="{{ shop.name }} — International Street Sports. Different lanes. Same vision. Coming soon.">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {{ 'jost-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'Jost'; font-weight: 300; font-display: swap; src: url({{ 'jost-latin-300-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Jost'; font-weight: 400; font-display: swap; src: url({{ 'jost-latin-400-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Jost'; font-weight: 500; font-display: swap; src: url({{ 'jost-latin-500-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-weight: 400; font-display: swap; src: url({{ 'ibm-plex-mono-latin-400-normal.woff2' | asset_url }}) format('woff2'); }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
