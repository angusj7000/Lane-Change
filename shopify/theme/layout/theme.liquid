<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a0a">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {% render 'meta-tags' %}

    {{ 'barlow-condensed-latin-600-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'ibm-plex-mono-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'Barlow Condensed'; font-weight: 500; font-style: normal; font-display: swap; src: url({{ 'barlow-condensed-latin-500-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Barlow Condensed'; font-weight: 600; font-style: normal; font-display: swap; src: url({{ 'barlow-condensed-latin-600-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-weight: 400; font-style: normal; font-display: swap; src: url({{ 'ibm-plex-mono-latin-400-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-weight: 500; font-style: normal; font-display: swap; src: url({{ 'ibm-plex-mono-latin-500-normal.woff2' | asset_url }}) format('woff2'); }
      @font-face { font-family: 'Cormorant Garamond'; font-weight: 500; font-style: normal; font-display: swap; src: url({{ 'cormorant-garamond-latin-500-normal.woff2' | asset_url }}) format('woff2'); }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.LC = {
        moneyFormat: {{ shop.money_format | json }},
        currency: {{ cart.currency.iso_code | json }},
        showCurrency: {{ settings.show_currency_code | json }},
        cartType: {{ settings.cart_type | json }},
        freeShipping: {{ settings.free_shipping_threshold | times: 100 | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          selectSize: {{ 'products.product.select_size' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          remove: {{ 'cart.remove' | t | json }},
          freeShippingAway: {{ 'cart.free_shipping_away' | t | json }},
          freeShippingUnlocked: {{ 'cart.free_shipping_unlocked' | t | json }},
          noResults: {{ 'search.no_results_short' | t | json }},
          savedToWishlist: {{ 'wishlist.saved' | t | json }},
          removedFromWishlist: {{ 'wishlist.removed' | t | json }},
          error: {{ 'general.error' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}{% render 'cart-drawer' %}{%- endif -%}
    {% render 'search-overlay' %}

    {%- if settings.show_grain -%}<div class="grain" aria-hidden="true"></div>{%- endif -%}
    <div class="toast micro" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
