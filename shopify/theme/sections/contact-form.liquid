{%- liquid
  assign support_email = section.settings.email | default: settings.support_email | default: shop.email
-%}
<section class="wrap section contact" id="contact">
  {%- form 'contact', class: 'cform', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <div class="cform__notice" role="status">
        <p class="eyebrow">{{ 'contact.success_title' | t }}</p>
        <p>{{ 'contact.success' | t }}</p>
      </div>
    {%- elsif form.errors -%}
      <p class="micro buy__msg" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="cform__row">
      <div><label class="lbl micro" for="c-name">{{ 'contact.name' | t }}</label><input class="field" id="c-name" name="contact[name]" autocomplete="name" value="{{ form.name }}" required></div>
      <div><label class="lbl micro" for="c-email">{{ 'contact.email' | t }}</label><input class="field" id="c-email" name="contact[email]" type="email" autocomplete="email" value="{{ form.email }}" required></div>
    </div>
    <div class="cform__row">
      <div><label class="lbl micro" for="c-topic">{{ 'contact.topic' | t }}</label>
        <select class="field" id="c-topic" name="contact[topic]">
          {%- assign topics = section.settings.topics | split: ',' -%}
          {%- for t in topics -%}<option>{{ t | strip }}</option>{%- endfor -%}
        </select>
      </div>
      <div><label class="lbl micro" for="c-order">{{ 'contact.order_number' | t }} <span class="muted">{{ 'contact.optional' | t }}</span></label><input class="field" id="c-order" name="contact[order_number]" value="{{ form.order_number }}" placeholder="#1001"></div>
    </div>
    <div><label class="lbl micro" for="c-msg">{{ 'contact.message' | t }}</label><textarea class="field" id="c-msg" name="contact[body]" rows="7" required>{{ form.body }}</textarea></div>
    <button class="btn btn--solid" type="submit">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow' %}</button>
  {%- endform -%}

  <aside class="cinfo">
    {%- if support_email != blank -%}
      <div><p class="micro muted">Email</p><a class="u-link" href="mailto:{{ support_email }}">{{ support_email }}</a></div>
    {%- endif -%}
    {%- if section.settings.collab_email != blank -%}
      <div><p class="micro muted">Collaborations &amp; wholesale</p><a class="u-link" href="mailto:{{ section.settings.collab_email }}">{{ section.settings.collab_email }}</a></div>
    {%- endif -%}
    {%- if section.settings.response_note != blank -%}
      <div><p class="micro muted">Replies</p><p>{{ section.settings.response_note }}</p></div>
    {%- endif -%}
    {%- if shop.shipping_policy or shop.refund_policy or settings.social_instagram != blank -%}
      <div><p class="micro muted">Quick help</p>
        <ul class="cinfo__links">
          {%- if shop.shipping_policy -%}<li><a class="u-link" href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
          {%- if shop.refund_policy -%}<li><a class="u-link" href="{{ shop.refund_policy.url }}">Returns &amp; refunds</a></li>{%- endif -%}
          {%- if customer -%}<li><a class="u-link" href="{{ routes.account_url }}">Your orders</a></li>{%- elsif shop.customer_accounts_enabled -%}<li><a class="u-link" href="{{ routes.account_login_url }}">Track an order</a></li>{%- endif -%}
        </ul>
      </div>
    {%- endif -%}
    {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank -%}
      <div><p class="micro muted">Social</p>
        <ul class="cinfo__links">
          {%- if settings.social_instagram != blank -%}<li><a class="u-link" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a class="u-link" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a class="u-link" href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a></li>{%- endif -%}
        </ul>
      </div>
    {%- endif -%}
    <div><p class="micro muted">Based</p><p>{{ settings.brand_origin }}</p></div>
  </aside>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "topics", "label": "Topics (comma separated)", "default": "Order enquiry, Sizing, Returns & exchanges, Collaboration, Wholesale, Other" },
    { "type": "text", "id": "email", "label": "Contact email", "info": "Leave empty to use Theme settings → Brand → Customer support email, or your store email." },
    { "type": "text", "id": "collab_email", "label": "Collaborations & wholesale email", "info": "Optional." },
    { "type": "text", "id": "response_note", "label": "Reply time note", "info": "Optional, e.g. “We reply within 1–2 business days.” Only add it once you can keep to it." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
