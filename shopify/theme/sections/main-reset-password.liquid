{%- assign t_title = 'customer.reset' | t -%}
{% render 'page-head', eyebrow: shop.name, title: t_title %}
<section class="wrap section">
  {%- form 'reset_customer_password', class: 'acct__form' -%}
    {%- if form.errors -%}<p class="micro buy__msg" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="lbl micro" for="rs-pass">{{ 'customer.password' | t }}</label>
    <input class="field" id="rs-pass" type="password" name="customer[password]" autocomplete="new-password" required>
    <label class="lbl micro" for="rs-conf">{{ 'customer.confirm_password' | t }}</label>
    <input class="field" id="rs-conf" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn btn--solid btn--block" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Reset password", "tag": "div", "settings": [] }
{% endschema %}
