{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.mobile_image | default: section.settings.image
-%}
<section class="cs" aria-labelledby="cs-title">
  <picture class="cs__media">
    {%- if img_m -%}
      <source media="(max-width: 700px) and (orientation: portrait)" srcset="{{ img_m | image_url: width: 600 }} 600w, {{ img_m | image_url: width: 900 }} 900w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="100vw">
    {%- else -%}
      <source media="(max-width: 700px) and (orientation: portrait)" srcset="{{ 'coming-soon-mobile.jpg' | asset_url }}">
    {%- endif -%}
    {%- if img -%}
      {{ img | image_url: width: 2400 | image_tag: widths: '1200, 1600, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      <img src="{{ 'coming-soon.jpg' | asset_url }}" alt="" width="1920" height="1280" fetchpriority="high">
    {%- endif -%}
  </picture>
  <div class="cs__shade" aria-hidden="true"></div>

  <header class="cs__top">
    <span class="cs__logo" aria-label="{{ shop.name }}">{% render 'logo-wordmark' %}</span>
    <button class="cs__enter cs-small" type="button" data-cs-open aria-haspopup="dialog" aria-controls="cs-enter">
      {{ section.settings.enter_label }} <span class="cs__line" aria-hidden="true"></span>
    </button>
  </header>

  <div class="cs__centre">
    <h1 id="cs-title" class="cs__wordmark">{% render 'logo-wordmark-drip' %}<span class="sr-only">{{ shop.name }}</span></h1>
    <p class="cs__line-1">{{ section.settings.line }}</p>
    <span class="cs__rule" aria-hidden="true"></span>
    <p class="cs__tagline">{{ section.settings.tagline }}</p>
    <p class="cs__soon">{{ section.settings.coming_soon }}</p>

    {%- form 'customer', class: 'cs__form', id: 'cs-notify' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="cs__done cs-small" role="status">{{ section.settings.success }}</p>
      {%- else -%}
        <label class="sr-only" for="cs-email">{{ section.settings.email_placeholder }}</label>
        <input class="cs__input" id="cs-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ section.settings.email_placeholder }}" required>
        <button class="cs__btn" type="submit">{{ section.settings.button_label }}</button>
        {%- if form.errors -%}
          <p class="cs__error cs-small" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>

  <footer class="cs__bottom">
    <nav class="cs__social cs-small" aria-label="Social">
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
    </nav>
    <p class="cs__region cs-small">{{ settings.brand_origin }} <span class="cs__line" aria-hidden="true"></span></p>
  </footer>

  {%- comment -%} Password entry for people who have it {%- endcomment -%}
  <dialog class="cs__dialog" id="cs-enter" aria-labelledby="cs-enter-title">
    <button class="cs__close" type="button" aria-label="{{ 'general.close' | t }}" data-cs-close>{% render 'icon', name: 'close' %}</button>
    <span class="cs__dialog-logo">{% render 'logo-wordmark' %}</span>
    <h2 id="cs-enter-title" class="cs-small">{{ 'password.enter' | t }}</h2>
    {%- form 'storefront_password', class: 'cs__form cs__form--pw' -%}
      <label class="sr-only" for="cs-password">{{ 'password.password' | t }}</label>
      <input class="cs__input" id="cs-password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
      <button class="cs__btn" type="submit">{{ 'password.submit' | t }}</button>
      {%- if form.errors -%}<p class="cs__error cs-small" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
    <p class="cs__owner cs-small">{{ 'password.owner' | t }} <a href="/admin">{{ 'password.login' | t }}</a></p>
  </dialog>
</section>

<script>
  (function () {
    var d = document.getElementById('cs-enter');
    if (!d || !d.showModal) return;
    var open = function () { d.showModal(); var i = d.querySelector('input[type=password]'); if (i) i.focus(); };
    document.querySelectorAll('[data-cs-open]').forEach(function (b) { b.addEventListener('click', open); });
    d.querySelectorAll('[data-cs-close]').forEach(function (b) { b.addEventListener('click', function () { d.close(); }); });
    d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
    if (d.querySelector('.cs__error')) open(); // wrong password: keep the panel open
  })();
</script>

{% schema %}
{
  "name": "Coming soon",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Shown to visitors while the store is password protected (Online Store → Preferences → Password protection)." },
    { "type": "image_picker", "id": "image", "label": "Background image (desktop)", "info": "Landscape, at least 1920px wide. Leave empty for the car-park campaign photo." },
    { "type": "image_picker", "id": "mobile_image", "label": "Background image (phones)", "info": "Portrait, model centred." },
    { "type": "text", "id": "line", "label": "Line under the logo", "default": "International Street Sports" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Different Lanes. Same Vision." },
    { "type": "text", "id": "coming_soon", "label": "Status", "default": "Coming Soon" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify Me" },
    { "type": "text", "id": "success", "label": "Message after signing up", "default": "You're on the list. We'll let you know first." },
    { "type": "text", "id": "enter_label", "label": "Password link label", "default": "Enter" }
  ]
}
{% endschema %}
