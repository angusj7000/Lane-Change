<section class="nf pw">
  {% render 'logo-wordmark', class: 'pw__logo' %}
  <p class="eyebrow eyebrow--wide">{{ settings.brand_line }}</p>
  <h1 class="display">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'news__form pw__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
    <label class="sr-only" for="pw-email">{{ 'newsletter.email' | t }}</label>
    <input class="field" id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
    <button class="btn btn--solid" type="submit">{{ 'newsletter.subscribe' | t }} {% render 'icon', name: 'arrow' %}</button>
    {%- if form.posted_successfully? -%}<p class="micro news__msg">{{ 'newsletter.success' | t }}</p>{%- endif -%}
  {%- endform -%}
  <details class="pw__enter">
    <summary class="micro u-link">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'news__form' -%}
      <label class="sr-only" for="pw-pass">{{ 'password.password' | t }}</label>
      <input class="field" id="pw-pass" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
      <button class="btn" type="submit">{{ 'password.submit' | t }}</button>
      {%- if form.errors -%}<p class="micro buy__msg">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
  <p class="micro muted">{{ settings.brand_est }} — {{ settings.brand_origin }}</p>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "div",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "New Roads Soon." } ]
}
{% endschema %}
