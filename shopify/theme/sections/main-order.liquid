{%- assign t_eyebrow = order.created_at | date: '%d %b %Y' -%}
{% render 'page-head', eyebrow: t_eyebrow, title: order.name %}
<section class="wrap section">
  {%- if order.cancelled -%}<p class="micro buy__msg">{%- assign cancelled_on = order.cancelled_at | date: '%d %b %Y' -%}{{ 'customer.cancelled' | t: date: cancelled_on }}</p>{%- endif -%}
  <table class="orders micro">
    <thead><tr><th>{{ 'customer.product' | t }}</th><th>{{ 'customer.sku' | t }}</th><th>{{ 'customer.price' | t }}</th><th>{{ 'customer.quantity' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr>
          <td>{{ line.title | link_to: line.product.url }}{% if line.fulfillment %}<br><span class="muted">{{ line.fulfillment.tracking_company }} {{ line.fulfillment.tracking_number }}</span>{% endif %}</td>
          <td>{{ line.sku }}</td>
          <td>{% render 'price', amount: line.final_price %}</td>
          <td>{{ line.quantity }}</td>
          <td>{% render 'price', amount: line.final_line_price %}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="4">{{ 'customer.subtotal' | t }}</td><td>{% render 'price', amount: order.line_items_subtotal_price %}</td></tr>
      {%- for s in order.shipping_methods -%}<tr><td colspan="4">{{ 'customer.shipping' | t }} ({{ s.title }})</td><td>{% render 'price', amount: s.price %}</td></tr>{%- endfor -%}
      {%- for tax in order.tax_lines -%}<tr><td colspan="4">{{ 'customer.tax' | t }} ({{ tax.title }})</td><td>{% render 'price', amount: tax.price %}</td></tr>{%- endfor -%}
      <tr><td colspan="4">{{ 'customer.total' | t }}</td><td>{% render 'price', amount: order.total_price %}</td></tr>
    </tfoot>
  </table>
  <div class="acct order-addresses">
    <div><p class="eyebrow">{{ 'customer.billing_address' | t }}</p><div class="muted">{{ order.billing_address | format_address }}</div></div>
    <div><p class="eyebrow">{{ 'customer.shipping_address' | t }}</p><div class="muted">{{ order.shipping_address | format_address }}</div></div>
  </div>
  <a class="link-arrow" href="{{ routes.account_url }}">{{ 'customer.return_to_account' | t }} {% render 'icon', name: 'arrow' %}</a>
</section>
{% schema %}
{ "name": "Customer order", "tag": "div", "settings": [] }
{% endschema %}
