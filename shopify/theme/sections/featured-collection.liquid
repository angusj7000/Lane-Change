{%- assign collection = section.settings.collection -%}
<section class="featured" aria-labelledby="featured-{{ section.id }}">
  <div class="featured__inner">
    <div class="section-bar">
      <h2 id="featured-{{ section.id }}" class="eyebrow eyebrow--wide reveal">{{ section.settings.heading }}</h2>
      <a class="link-arrow reveal" href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>
    </div>
    <div class="featured__grid" style="--cols: {{ section.settings.columns }}">
      {%- if collection and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}{% render 'product-card', product: blank, index: forloop.index0 %}{%- endfor -%}
      {%- endif -%}
      {%- if section.settings.show_more_tile -%}
        <a class="featured__more reveal" href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
          {% render 'logo-star', class: 'more__star' %}
          <span class="title">{{ 'general.shop_all' | t }}</span>
          {%- if collection -%}<span class="micro muted">{{ collection.title }}</span>{%- endif -%}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_more_tile", "label": "Show “Shop All” tile on tablet and mobile", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
