      { "type": "text", "id": "features_tees", "label": "Feature grid — tees", "default": "Oversized fit, Heavyweight cotton, Washed finish, Dropped shoulders", "info": "Comma separated. Used for product type T-Shirt." },
      { "type": "text", "id": "features_hoodies", "label": "Feature grid — hoodies", "default": "Oversized fit, 450gsm fleece, Washed finish, Dropped shoulders" },
