{%- comment -%}
  Thin-stroke Lane Change icon set.
  Usage: {% render 'icon', name: 'bag', px: 20 %}
{%- endcomment -%}
{%- assign s = px | default: 20 -%}
{%- if name == 'arrow' -%}
<svg class="arrow {{ class }}" viewBox="0 0 26 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M0 5h25M20.5 0.8 25 5l-4.5 4.2"/></svg>
{%- else -%}
<svg class="icon icon-{{ name }} {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
    {%- when 'bag' -%}<path d="M4.5 7.5h15l-1 13.5h-13z"/><path d="M8.5 7.5V6a3.5 3.5 0 0 1 7 0v1.5"/>
    {%- when 'menu' -%}<path d="M3 8h18M3 16h18"/>
    {%- when 'close' -%}<path d="M5 5l14 14M19 5 5 19"/>
    {%- when 'chevron' -%}<path d="m7 10 5 5 5-5"/>
    {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="3"/><path d="m10 9 5 3-5 3z"/>
  {%- endcase -%}
</svg>
{%- endif -%}
