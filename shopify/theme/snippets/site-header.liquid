{%- comment -%}
  Site header. Rendered from layout/theme.liquid (not a section) so it can never be
  hidden or removed in the theme editor. Options: Theme settings → Header.
{%- endcomment -%}
{%- liquid
  assign menu = settings.header_menu
  unless menu.links.size > 0
    assign menu = linklists[settings.header_menu]
  endunless
  assign use_brand_nav = true
  if settings.header_nav_source == 'menu' and menu.links.size > 0
    assign use_brand_nav = false
  endif

  # Brand navigation: SHOP · COLLECTION 001 · ABOUT · JOURNAL.
  # Collection 001 opens Shop All until that collection exists; About and
  # Journal stay hidden until their page / blog exist, so nothing is a dead link.
  assign brand_nav = 'Shop|' | append: routes.all_products_collection_url
  assign c001 = collections['collection-001']
  if c001.id != blank
    assign brand_nav = brand_nav | append: '^Collection 001|' | append: c001.url
  else
    assign brand_nav = brand_nav | append: '^Collection 001|' | append: routes.all_products_collection_url
  endif
  if pages.about.id != blank
    assign brand_nav = brand_nav | append: '^About|' | append: pages.about.url
  endif
  if blogs.journal.id != blank
    assign brand_nav = brand_nav | append: '^Journal|' | append: blogs.journal.url
  endif
  assign brand_nav = brand_nav | split: '^'
  assign overlay = false
  if settings.header_transparent_home and template.name == 'index'
    assign overlay = true
  elsif settings.header_transparent_banners and template.name == 'collection'
    assign overlay = true
  elsif settings.header_transparent_banners and template.name == 'article'
    assign overlay = true
  elsif settings.header_transparent_banners and template.suffix == 'about'
    assign overlay = true
  endif
-%}
{%- unless overlay -%}<style>#MainContent { padding-top: var(--header-h); } .hero { height: calc(100vh - var(--header-h)); height: calc(100svh - var(--header-h)); }</style>{%- endunless -%}
<header class="site-header" data-variant="{% if overlay %}overlay{% else %}solid{% endif %}" data-header>
  <div class="bar">
    <div class="bar__left">
      <button class="icon-btn menu-btn" type="button" aria-label="{{ 'general.open_menu' | t }}" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        {% render 'icon', name: 'menu', px: 24 %}
      </button>
      {%- if use_brand_nav -%}
        <nav class="primary only-desktop" aria-label="Primary">
          <ul>
            {%- for item in brand_nav -%}
              {%- assign parts = item | split: '|' -%}
              <li class="primary__item">
                <a class="primary__link u-link" href="{{ parts[1] }}"{% if request.path == parts[1] %} aria-current="page"{% endif %}>{{ parts[0] }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- elsif menu.links.size > 0 -%}
        <nav class="primary only-desktop" aria-label="Primary">
          <ul>
            {%- for link in menu.links -%}
              <li class="primary__item{% if link.links.size > 0 %} has-menu{% endif %}">
                <a class="primary__link u-link" href="{{ link.url }}"{% if link.active or link.child_active %} aria-current="page"{% endif %}>
                  {{ link.title }}
                  {%- if link.links.size > 0 %}{% render 'icon', name: 'chevron', px: 12, class: 'chev' %}{% endif -%}
                </a>
                {%- if link.links.size > 0 -%}
                  <div class="dropdown">
                    <ul>
                      {%- for child in link.links -%}
                        <li><a class="u-link" href="{{ child.url }}">{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                    <p class="micro muted dropdown__foot">{{ settings.brand_line }}</p>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <a class="bar__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.header_logo -%}
        {{ settings.header_logo | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '160px', alt: shop.name }}
      {%- else -%}
        {% render 'logo-wordmark' %}
      {%- endif -%}
    </a>

    <div class="bar__right">
      {%- if settings.header_region_text != blank -%}<span class="micro region only-desktop">{{ settings.header_region_text }}</span>{%- endif -%}
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}" data-search-open>{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn only-desktop" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a class="icon-btn bag{% if cart.item_count > 0 %} has-items{% endif %}" href="{{ routes.cart_url }}" aria-label="{{ 'general.bag_count' | t: count: cart.item_count }}" data-cart-open>
        {% render 'icon', name: 'bag' %}
        <span class="bag__count micro" data-cart-count>({{ cart.item_count }})</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}" hidden data-menu>
  <div class="mobile-menu__panel">
    <div class="mobile-menu__top">
      <button class="icon-btn" type="button" aria-label="{{ 'general.close_menu' | t }}" data-menu-close>{% render 'icon', name: 'close', px: 24 %}</button>
      <a class="bar__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% render 'logo-wordmark' %}</a>
      <span style="width:44px"></span>
    </div>
    <nav class="mobile-menu__nav" aria-label="{{ 'general.menu' | t }}">
      <ul>
        {%- assign menu_i = 0 -%}
        {%- if use_brand_nav -%}
          {%- for item in brand_nav -%}
            {%- assign parts = item | split: '|' -%}
            <li style="--d: {{ forloop.index0 | times: 0.05 | plus: 0.05 }}s"><a class="display" href="{{ parts[1] }}"{% if request.path == parts[1] %} aria-current="page"{% endif %}>{{ parts[0] }}</a></li>
            {%- assign menu_i = forloop.length -%}
          {%- endfor -%}
          {%- if pages.contact.id != blank -%}
            <li style="--d: {{ menu_i | times: 0.05 | plus: 0.05 }}s"><a class="display" href="{{ pages.contact.url }}"{% if request.path == pages.contact.url %} aria-current="page"{% endif %}>{{ 'general.contact' | t }}</a></li>
          {%- endif -%}
        {%- else -%}
        {%- for link in menu.links -%}
          <li style="--d: {{ forloop.index0 | times: 0.05 | plus: 0.05 }}s">
            <a class="display" href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="mobile-menu__sub">
                {%- for child in link.links -%}<li><a class="micro" href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <a class="micro" href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
      {%- if shop.customer_accounts_enabled -%}<a class="micro" href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>{%- endif -%}
      {%- if settings.wishlist_enabled -%}<a class="micro" href="{{ routes.root_url }}pages/wishlist">{{ 'general.wishlist' | t }}</a>{%- endif -%}
      {%- if shop.shipping_policy -%}<a class="micro" href="{{ shop.shipping_policy.url }}">{{ 'general.shipping' | t }}</a>{%- endif -%}
      {%- if shop.refund_policy -%}<a class="micro" href="{{ shop.refund_policy.url }}">{{ 'general.returns' | t }}</a>{%- endif -%}
      <span class="micro muted">{{ settings.header_region_text }}</span>
    </div>
  </div>
</div>
