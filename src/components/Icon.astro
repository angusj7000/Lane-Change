---
// Thin-stroke icon set drawn for Lane Change (1.25px strokes, square caps).
interface Props {
  name: 'search' | 'account' | 'bag' | 'menu' | 'close' | 'chevron' | 'arrow' | 'heart' | 'plus' | 'minus' | 'instagram' | 'tiktok' | 'youtube';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
---
{name === 'arrow' ? (
  <svg class:list={['arrow', cls]} viewBox="0 0 26 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
    <path d="M0 5h25M20.5 0.8 25 5l-4.5 4.2" />
  </svg>
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true">
    {name === 'search' && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></>}
    {name === 'account' && <><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></>}
    {name === 'bag' && <><path d="M4.5 7.5h15l-1 13.5h-13z" /><path d="M8.5 7.5V6a3.5 3.5 0 0 1 7 0v1.5" /></>}
    {name === 'menu' && <><path d="M3 8h18M3 16h18" /></>}
    {name === 'close' && <><path d="M5 5l14 14M19 5 5 19" /></>}
    {name === 'chevron' && <path d="m7 10 5 5 5-5" />}
    {name === 'heart' && <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z" />}
    {name === 'plus' && <path d="M12 5v14M5 12h14" />}
    {name === 'minus' && <path d="M5 12h14" />}
    {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" /></>}
    {name === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6" />}
    {name === 'youtube' && <><rect x="2.5" y="5.5" width="19" height="13" rx="3" /><path d="m10 9 5 3-5 3z" /></>}
  </svg>
)}
