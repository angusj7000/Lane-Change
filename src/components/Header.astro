---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { primaryNav, site } from '../config/site';

interface Props {
  /** overlay = transparent over a hero image; solid = inner pages */
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" data-variant={variant} data-header>
  <div class="bar">
    <div class="bar__left">
      <button class="icon-btn only-mobile" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        <Icon name="menu" size={24} />
      </button>
      <nav class="primary only-desktop" aria-label="Primary">
        <ul>
          {primaryNav.map((item) => (
            <li class:list={['primary__item', { 'has-menu': 'menu' in item }]}>
              <a class:list={['primary__link', 'u-link']} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                {'menu' in item && <Icon name="chevron" size={12} class="chev" />}
              </a>
              {'menu' in item && (
                <div class="dropdown">
                  <ul>
                    {item.menu.map((sub) => (
                      <li><a class="u-link" href={sub.href}>{sub.label}</a></li>
                    ))}
                  </ul>
                  <p class="micro muted dropdown__foot">{site.line}</p>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <a class="bar__logo" href="/" aria-label="Lane Change — home">
      <Brand mark="wordmark" />
    </a>

    <div class="bar__right">
      <span class="micro region only-desktop">{site.origin}</span>
      <button class="icon-btn" type="button" aria-label="Search" data-search-open>
        <Icon name="search" />
      </button>
      <a class="icon-btn only-desktop" href="/account" aria-label="Account">
        <Icon name="account" />
      </a>
      <button class="icon-btn bag" type="button" aria-label="Shopping bag, 0 items" data-cart-open>
        <Icon name="bag" />
        <span class="bag__count micro" data-cart-count>(0)</span>
      </button>
    </div>
  </div>
</header>

<!-- mobile menu -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="mobile-menu__top">
    <button class="icon-btn" type="button" aria-label="Close menu" data-menu-close><Icon name="close" size={24} /></button>
    <a class="bar__logo" href="/" aria-label="Lane Change — home"><Brand mark="wordmark" /></a>
    <span style="width:44px"></span>
  </div>
  <nav class="mobile-menu__nav" aria-label="Mobile">
    <ul>
      {primaryNav.map((item, i) => (
        <li style={`--d:${0.05 + i * 0.05}s`}>
          <a class="display" href={item.href}>{item.label}</a>
          {'menu' in item && (
            <ul class="mobile-menu__sub">
              {item.menu.map((sub) => <li><a class="micro" href={sub.href}>{sub.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
      <li style="--d:0.25s"><a class="display" href="/contact">Contact</a></li>
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a class="micro" href="/account">Account</a>
    <a class="micro" href="/wishlist">Wishlist</a>
    <span class="micro muted">{site.origin}</span>
  </div>
</div>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 90;
    height: var(--header-h);
    color: var(--bone);
    transition: background-color 0.5s var(--ease), border-color 0.5s var(--ease), transform 0.5s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header[data-variant='solid'],
  .site-header.is-scrolled {
    background: rgba(10, 10, 10, 0.92);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .site-header[data-variant='overlay']:not(.is-scrolled)::before {
    /* soft top scrim so nav stays legible over bright photography */
    content: ''; position: absolute; inset: 0 0 -40px 0; z-index: -1; pointer-events: none;
    background: linear-gradient(rgba(0,0,0,.45), rgba(0,0,0,0));
  }

  .bar {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--gutter);
    max-width: 1920px; margin-inline: auto;
  }
  .bar__left { display: flex; align-items: center; }
  .bar__right { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }

  .bar__logo { display: block; width: clamp(118px, 12vw, 158px); color: var(--white); }
  .bar__logo :global(svg) { width: 100%; height: auto; }

  .primary ul { display: flex; gap: clamp(22px, 3vw, 52px); }
  .primary__item { position: relative; }
  .primary__link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; letter-spacing: var(--track-sm); text-transform: uppercase;
    height: var(--header-h);
    background-position: 0 calc(50% + 12px);
  }
  .primary__link :global(.chev) { transition: transform 0.3s var(--ease); }
  .has-menu:hover :global(.chev), .has-menu:focus-within :global(.chev) { transform: rotate(180deg); }

  .dropdown {
    position: absolute; top: calc(var(--header-h) - 14px); left: -22px;
    min-width: 240px; padding: 22px;
    background: rgba(10, 10, 10, 0.96);
    border: 1px solid var(--line);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0.3s;
  }
  .dropdown ul { display: flex; flex-direction: column; gap: 14px; }
  .dropdown a { font-size: 11px; letter-spacing: var(--track-sm); text-transform: uppercase; }
  .dropdown__foot { margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--line); }
  .has-menu:hover .dropdown, .has-menu:focus-within .dropdown { opacity: 1; visibility: visible; transform: none; }

  .region { margin-right: clamp(10px, 2vw, 28px); letter-spacing: var(--track-md); }

  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-width: 44px; height: 44px;
    transition: opacity 0.3s var(--ease);
  }
  .icon-btn:hover { opacity: 0.65; }
  .bag__count { letter-spacing: 0.08em; font-size: 10px; }

  .only-mobile { display: none; }
  @media (max-width: 900px) {
    .only-desktop { display: none !important; }
    .only-mobile { display: inline-flex; }
    .bar__left .icon-btn { margin-left: -10px; }
    .bar__right { gap: 0; margin-right: -10px; }
    .bag__count { display: none; }
    .bag { position: relative; }
    .bag.has-items::after {
      content: ''; position: absolute; top: 11px; right: 10px;
      width: 6px; height: 6px; border-radius: 50%; background: var(--bone);
    }
  }

  /* ----- mobile menu ----- */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 120;
    display: flex; flex-direction: column;
    background: var(--black);
    padding: 0 var(--gutter) calc(24px + env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__top {
    height: var(--header-h); display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--line); margin-inline: calc(var(--gutter) * -1); padding-inline: calc(var(--gutter) - 10px);
  }
  .mobile-menu__nav { flex: 1; padding-top: 28px; }
  .mobile-menu__nav > ul > li {
    padding-block: 14px; border-bottom: 1px solid var(--line);
    opacity: 0; transform: translateY(12px);
    animation: menu-in 0.7s var(--ease-out) forwards; animation-delay: var(--d);
  }
  .mobile-menu__nav .display { font-size: clamp(40px, 12vw, 64px); letter-spacing: 0.04em; }
  .mobile-menu__sub { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 10px; color: var(--smoke); }
  .mobile-menu__foot { display: flex; flex-wrap: wrap; gap: 12px 22px; justify-content: space-between; padding-top: 28px; }
  @keyframes menu-in { to { opacity: 1; transform: none; } }
</style>
