---
import ProductCard from '../ProductCard.astro';
import Icon from '../Icon.astro';
import Brand from '../Brand.astro';
import { featuredSlugs, getProduct } from '../../data/products';

const featured = featuredSlugs.map(getProduct).filter((p) => p !== undefined);
---
<section class="featured" aria-labelledby="featured-title">
  <div class="featured__inner">
    <div class="section-bar">
      <h2 id="featured-title" class="eyebrow eyebrow--wide reveal">Featured Collection</h2>
      <a class="link-arrow reveal" href="/collections/core-washed">View All <Icon name="arrow" /></a>
    </div>
    <div class="featured__grid">
      {featured.map((p, i) => <ProductCard product={p} index={i} />)}
      <a class="featured__more reveal" href="/shop">
        <Brand mark="star" class="more__star" />
        <span class="title">Shop All</span>
        <span class="micro muted">Core Washed — SS25</span>
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .featured { background: #0d0d0d; padding-block: clamp(28px, 3vw, 44px) clamp(40px, 5vw, 72px); }
  .featured__inner { padding-inline: clamp(16px, 2.6vw, 40px); max-width: 1920px; margin-inline: auto; }
  .featured .section-bar { padding-inline: clamp(0px, 0.6vw, 10px); }
  .featured__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
  }
  .featured__more {
    display: none;
    flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    text-align: center;
    transition: border-color 0.4s var(--ease);
  }
  .featured__more:hover { border-color: var(--line-strong); }
  .featured__more .title { font-size: 26px; letter-spacing: 0.16em; }
  .featured__more :global(.more__star) { width: 20px; color: var(--bone); }

  @media (max-width: 1100px) {
    .featured__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 40px; }
    .featured__more { display: flex; }
  }
  @media (max-width: 700px) {
    .featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 12px; }
  }
</style>
